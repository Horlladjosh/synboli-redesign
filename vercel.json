{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/work-with-us/:path*",
      "destination": "/services/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow, noimageindex"
        }
      ]
    }
  ]
}
